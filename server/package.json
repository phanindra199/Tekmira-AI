{
  "name": "tekmira-ai-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tekmira AI Backend REST API Engine",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch-path=src src/server.js",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "db:seed": "node src/database/seed.js",
    "test:relational": "node src/database/testRelationalQueries.js",
    "test:mongo": "node src/database/testMongoCrud.js",
    "test:auth": "node src/test/testAuthSecurity.js",
    "test:rest": "node src/test/testRestApiIntegration.js",
    "test:gemini": "node src/test/testGeminiIntegration.js",
    "test:prompts": "node src/test/testPromptAndSchemas.js",
    "test:pdf": "node src/test/testPdfUploadAndExtraction.js",
    "test:github": "node src/test/testGitHubIntegration.js",
    "test:matching": "node src/test/testMatchingEngine.js",
    "test": "node src/database/testRelationalQueries.js && node src/database/testMongoCrud.js && node src/test/testAuthSecurity.js && node src/test/testRestApiIntegration.js && node src/test/testGeminiIntegration.js && node src/test/testPromptAndSchemas.js && node src/test/testPdfUploadAndExtraction.js && node src/test/testGitHubIntegration.js && node src/test/testMatchingEngine.js"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.1",
    "multer": "^2.5.0",
    "pdf-parse": "^2.4.5",
    "prisma": "^6.19.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
